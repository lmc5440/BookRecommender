   "outputs": [],
   "source": [
    "# Create a function to recommend books using our model\n",
    "def recommend_book_ver2(title, review):\n",
    "    # Clean the user's input review\n",
    "    user_review = clean_func(review)\n",
    "    # Vectorize the user review\n",
    "    review_vectorized = vectorizer.transform([user_review])\n",
    "    # Find nearest neighbors using the model\n",
    "    _, indices = model.kneighbors(review_vectorized)\n",
    "    # Get recommended books\n",
    "    books = merged_df.iloc[indices[0]].drop_duplicates(subset='title')\n",
    "    # Create a string of recommendations\n",
    "    recommendations = \"\"\n",
    "    for _, row in books.iterrows():\n",
    "        recommendations += f\"[{row['title']}] by {row['author']}\\n\"\n",
    "\n",
    "    return recommendations"
   ]
  },
